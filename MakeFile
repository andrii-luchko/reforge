.PHONY: aab ipa test

DEBUG_INFO_DIR := debug_symbols
DESKTOP_BUILD_DIR := $(HOME)/Desktop/reforge_builds

define increment_build_number
$(shell \
	if [ ! -f $(1) ]; then \
		echo 1 > $(1); \
	else \
		expr $$(cat $(1)) + 1 > $(1); \
	fi; \
	cat $(1))
endef

define check_args
	@if [ -z "$(1)" ]; then \
		echo "Usage: make $(2) <version> [clean]"; \
		echo "Example: make $(2) 1.0.0"; \
		exit 1; \
	fi
endef

test:
	@echo "Makefile is alive!"
	@echo "Desktop path: $(DESKTOP_BUILD_DIR)"

aab:
	$(eval VERSION := $(word 2,$(MAKECMDGOALS)))
	$(eval CLEAN := $(word 3,$(MAKECMDGOALS)))
	$(call check_args,$(VERSION),aab)
	$(eval BUILD_NUMBER_FILE := .build_number_aab)
	$(eval BUILD_NUMBER := $(call increment_build_number,$(BUILD_NUMBER_FILE)))
	@echo "🚀 Building Android AAB | Version: $(VERSION) | Build: $(BUILD_NUMBER)"
	@mkdir -p $(DEBUG_INFO_DIR)
	@if [ "$(CLEAN)" = "clean" ]; then \
		echo "🧹 Cleaning project..."; \
		flutter clean; \
		flutter pub get; \
	fi
	flutter build appbundle --release \
		--build-name=$(VERSION) \
		--build-number=$(BUILD_NUMBER) \
		--dart-define-from-file=env.json \
		--obfuscate --split-debug-info=$(DEBUG_INFO_DIR)/android
	@echo "📦 Copying to Desktop..."
	@mkdir -p $(DESKTOP_BUILD_DIR)/aab
	@cp build/app/outputs/bundle/release/app-release.aab $(DESKTOP_BUILD_DIR)/aab/reforge-$(VERSION)-$(BUILD_NUMBER).aab
	@echo "✅ Done! Check Desktop/reforge_builds/aab"

ipa:
	$(eval VERSION := $(word 2,$(MAKECMDGOALS)))
	$(eval CLEAN := $(word 3,$(MAKECMDGOALS)))
	$(call check_args,$(VERSION),ipa)
	$(eval BUILD_NUMBER_FILE := .build_number_ipa)
	$(eval BUILD_NUMBER := $(call increment_build_number,$(BUILD_NUMBER_FILE)))
	@echo "🚀 Building iOS IPA | Version: $(VERSION) | Build: $(BUILD_NUMBER)"
	@mkdir -p $(DEBUG_INFO_DIR)
	@if [ "$(CLEAN)" = "clean" ]; then \
		echo "🧹 Cleaning project..."; \
		flutter clean; \
		flutter pub get; \
	fi
	flutter build ipa --release \
		--build-name=$(VERSION) \
		--build-number=$(BUILD_NUMBER) \
		--dart-define-from-file=env.json \
		--obfuscate --split-debug-info=$(DEBUG_INFO_DIR)/ios
	@echo "📦 Copying to Desktop..."
	@mkdir -p $(DESKTOP_BUILD_DIR)/ipa
	@cp build/ios/ipa/*.ipa $(DESKTOP_BUILD_DIR)/ipa/reforge-$(VERSION)-$(BUILD_NUMBER).ipa
	@echo "✅ Done! Check Desktop/reforge_builds/ipa"

%:
	@: