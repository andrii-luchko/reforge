.PHONY: aab ipa test

DEBUG_INFO_DIR := debug_symbols
DESKTOP_BUILD_DIR := $(HOME)/Desktop/reforge_builds

define increment_build_number
$(shell \
	if [ ! -f $(1) ]; then \
		echo 1 > $(1); \
	else \
		expr $$(cat $(1)) + 1 > $(1); \
	fi; \
	cat $(1))
endef

define check_args
	@if [ -z "$(1)" ] || [ -z "$(2)" ]; then \
		echo "Usage: make $(3) <flavor> <version> [clean]"; \
		echo "Example: make $(3) prod 1.0.0"; \
		exit 1; \
	fi
endef

test:
	@echo "Makefile is alive!"
	@echo "Desktop path: $(DESKTOP_BUILD_DIR)"

aab:
	$(eval FLAVOR := $(word 2,$(MAKECMDGOALS)))
	$(eval VERSION := $(word 3,$(MAKECMDGOALS)))
	$(eval CLEAN := $(word 4,$(MAKECMDGOALS)))
	$(call check_args,$(FLAVOR),$(VERSION),aab)
	$(eval BUILD_NUMBER_FILE := .build_number_aab_$(FLAVOR))
	$(eval BUILD_NUMBER := $(call increment_build_number,$(BUILD_NUMBER_FILE)))
	@echo "🚀 Building Android AAB: $(FLAVOR) | Version: $(VERSION) | Build: $(BUILD_NUMBER)"
	@mkdir -p $(DEBUG_INFO_DIR)
	@if [ "$(CLEAN)" = "clean" ]; then \
		echo "🧹 Cleaning project..."; \
		flutter clean; \
		flutter pub get; \
	fi
	flutter build appbundle --release \
		--build-name=$(VERSION) \
		--build-number=$(BUILD_NUMBER) \
		--flavor $(FLAVOR) \
		--dart-define-from-file=env_$(FLAVOR).json \
		--obfuscate --split-debug-info=$(DEBUG_INFO_DIR)/android-$(FLAVOR)
	@echo "📦 Copying to Desktop..."
	@mkdir -p $(DESKTOP_BUILD_DIR)/$(FLAVOR)/aab
	@cp build/app/outputs/bundle/$(FLAVOR)Release/app-$(FLAVOR)-release.aab $(DESKTOP_BUILD_DIR)/$(FLAVOR)/aab/reforge-$(VERSION)-$(BUILD_NUMBER).aab
	@echo "✅ Done! Check Desktop/reforge_builds"

ipa:
	$(eval FLAVOR := $(word 2,$(MAKECMDGOALS)))
	$(eval VERSION := $(word 3,$(MAKECMDGOALS)))
	$(eval CLEAN := $(word 4,$(MAKECMDGOALS)))
	$(call check_args,$(FLAVOR),$(VERSION),ipa)
	$(eval BUILD_NUMBER_FILE := .build_number_ipa_$(FLAVOR))
	$(eval BUILD_NUMBER := $(call increment_build_number,$(BUILD_NUMBER_FILE)))
	@echo "🚀 Building iOS IPA: $(FLAVOR) | Version: $(VERSION) | Build: $(BUILD_NUMBER)"
	@mkdir -p $(DEBUG_INFO_DIR)
	@if [ "$(CLEAN)" = "clean" ]; then \
		echo "🧹 Cleaning project..."; \
		flutter clean; \
		flutter pub get; \
	fi
	flutter build ipa --release \
		--build-name=$(VERSION) \
		--build-number=$(BUILD_NUMBER) \
		--flavor $(FLAVOR) \
		--dart-define-from-file=env_$(FLAVOR).json \
		--obfuscate --split-debug-info=$(DEBUG_INFO_DIR)/ios-$(FLAVOR)
	@echo "📦 Copying to Desktop..."
	@mkdir -p $(DESKTOP_BUILD_DIR)/$(FLAVOR)/ipa
	@cp build/ios/ipa/*.ipa $(DESKTOP_BUILD_DIR)/$(FLAVOR)/ipa/reforge-$(VERSION)-$(BUILD_NUMBER).ipa
	@echo "✅ Done! Check Desktop/reforge_builds"

%:
	@: